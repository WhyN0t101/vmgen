# VMGen Worker Environment Configuration
# Copy this file to .env and fill in your values

# Proxmox API Configuration
PROXMOX_HOST=https://[IP_ADDRESS]
PROXMOX_TOKEN_ID=vmgen@pam!worker
PROXMOX_TOKEN_SECRET=token
PROXMOX_VERIFY_SSL=true
PROXMOX_NODE=pve
# Must be a bridge/subnet genuinely separate from wherever your management/platform
# VM lives -- two hosts sharing one subnet bypass any firewall between them via
# direct ARP/switching, regardless of firewall rules. vmbr2 in the reference deployment.
PROXMOX_ISOLATED_BRIDGE=vmbr2
# SSH key used by the worker to connect to the Proxmox host for OVA export
PROXMOX_SSH_USER=root
PROXMOX_SSH_KEY_PATH=/home/vmgen/.ssh/proxmox_id_rsa
# Known hosts file for SSH host key verification of the Proxmox host.
# Populate once with: ssh-keyscan -H <PROXMOX_HOST_IP> >> ~/.ssh/known_hosts
# Defaults to ~/.ssh/known_hosts if not set.
PROXMOX_KNOWN_HOSTS_PATH=/home/vmgen/.ssh/known_hosts

# Backend Configuration
BACKEND_URL=http://localhost:8080
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BACKEND_API_KEY=change_me

# OVA export path — must be writable by the worker (NFS mount if worker is separate from Proxmox host)
EXPORT_PATH=/var/lib/vmgen/exports

# Worker Configuration
WORKER_ID=worker-01
WORKER_POLL_INTERVAL_SECONDS=30
WORKER_MAX_CONCURRENT_BUILDS=3
LOG_LEVEL=INFO
