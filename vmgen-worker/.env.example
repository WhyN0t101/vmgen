# VMGen Worker Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=vmgen
DATABASE_USER=vmgen
DATABASE_PASSWORD=password

# Proxmox API Configuration
PROXMOX_HOST=https://[IP_ADDRESS]
PROXMOX_TOKEN_ID=vmgen@pam!worker
PROXMOX_TOKEN_SECRET=token
PROXMOX_VERIFY_SSL=true
PROXMOX_NODE=pve

# Security
# 256-bit secret for HMAC-SHA256 flag generation
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PLATFORM_SECRET=secret

# Worker Configuration
WORKER_ID=worker-01
LOG_LEVEL=INFO

# Backend Configuration
BACKEND_URL=http://localhost:3000
BACKEND_API_KEY=<generate with: python -c "import secrets; print(secrets.token_hex(32))">
