## Copy to: vmgen/vmgen-api/.env
## DO NOT COMMIT .env

# VMGen JWT secret (>= 32 bytes recommended)
VMGEN_JWT_SECRET=CHANGE_ME

# Frontend origins (comma-separated)
VMGEN_CORS_ORIGINS=http://localhost:5173

# Proxmox API
PROXMOX_API_URL=https://172.22.21.95:8006/api2/json
PROXMOX_TOKEN_ID=worker@pve!automation
PROXMOX_TOKEN_SECRET=CHANGE_ME
PROXMOX_VERIFY_SSL=false
PROXMOX_NODE=pve

