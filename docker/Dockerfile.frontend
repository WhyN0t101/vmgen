# Build context: vmgen/ (one level above docker/)
# This allows access to both vmgen-frontend/ and docker/nginx.conf

FROM node:22-alpine AS build
WORKDIR /app
COPY vmgen-frontend/package*.json ./
RUN npm ci
COPY vmgen-frontend/ .
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
