# =============================================================================
# VMGen Docker Environment — copy to .env and fill in values
# NEVER commit .env to version control
# =============================================================================
#
# Quick start:
#   cd vmgen/docker
#   cp .env.example .env
#   # Fill in all values marked CHANGE_ME below
#   docker compose up -d
#
# -----------------------------------------------------------------------------
# Deploy notes:
#
# 1. CORS: VMGEN_CORS_ORIGINS must equal the exact URL in the browser address
#    bar (scheme + host + port), e.g. http://192.168.45.133. Mismatch = login
#    fails with a CORS error.
#
# 2. Platform-only first: to bring up the app without Proxmox, start just the
#    three core services — the worker needs real Proxmox access:
#    docker compose up -d --build postgres vmgen-api vmgen-frontend
#    The API does NOT connect to Proxmox at startup (only validates PROXMOX_*
#    are non-blank), so placeholder Proxmox values are fine for this.
#
# 3. Frontend build: if `npm run build` fails on vue-tsc type-check errors but
#    `vite build` itself succeeds, switch Dockerfile.frontend to
#    `RUN npm run build-only` to skip the type-check gate.
#
# 4. Worker SSH key: PROXMOX_SSH_KEY_PATH / PROXMOX_KNOWN_HOSTS_PATH must point
#    to files that EXIST on this host before `docker compose up vmgen-worker`,
#    or Docker creates empty DIRS at those paths. The key must be chmod 0600
#    (the worker refuses to start otherwise). Match the path to your real user
#    home (e.g. /home/ubuntu/.ssh, not the /home/vmgen default below).
#
# 5. Worker fails closed: on startup it verifies the isolated bridge has no
#    gateway via the Proxmox API. No Proxmox reachability = it exits(1) and
#    restart-loops. Expected. Stop it (docker compose stop vmgen-worker) until
#    Proxmox is reachable.
#
# 6. Access: from another machine, browse to http://<VM_IP>:$FRONTEND_PORT, or
#    SSH-tunnel:  ssh -L 8080:localhost:80 user@<VM_IP>  → http://localhost:8080
#    (set CORS to match whichever URL you use).
#
# =============================================================================


# --- Database ---
DB_NAME=vmgen
DB_USER=vmgen
# Generate: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_strong_password


# --- JWT secret (min 32 chars) ---
# Generate: openssl rand -base64 32
VMGEN_JWT_SECRET=CHANGE_ME_jwt_secret_min_32_characters_long


# --- Platform secret — MUST match on API and worker (min 32 chars) ---
# Generate: openssl rand -base64 32
PLATFORM_SECRET=CHANGE_ME_platform_secret_min_32_characters


# --- Worker API key — shared between API and worker ---
# Generate: openssl rand -hex 32
WORKER_API_KEY=CHANGE_ME_worker_api_key


# --- CORS ---
# Comma-separated origins that the browser will be accessing the app from.
# Example: http://192.168.1.10  or  https://vmgen.yourdomain.com
VMGEN_CORS_ORIGINS=http://192.168.1.10


# --- Proxmox API ---
PROXMOX_HOST=172.22.21.95
PROXMOX_API_URL=https://172.22.21.95:8006/api2/json
PROXMOX_TOKEN_ID=worker@pve!automation
# Found in Proxmox UI under Datacenter > Permissions > API Tokens
PROXMOX_TOKEN_SECRET=CHANGE_ME_proxmox_token_secret
PROXMOX_VERIFY_SSL=false
PROXMOX_NODE=pve
PROXMOX_ISOLATED_BRIDGE=vmbr1
# Linux user on the Proxmox host the worker SSHs in as
PROXMOX_SSH_USER=vmgen


# --- SSH key for worker → Proxmox host ---
#
# The worker SSHs into the Proxmox host (172.22.21.95) to run qm commands
# and export OVAs. These paths point to files ON THIS VM (the Platform VM),
# and are bind-mounted read-only into the worker container.
#
# Setup (run once on this VM as the user that owns the files):
#
#   1. Generate an ed25519 key pair:
#        ssh-keygen -t ed25519 -f ~/.ssh/vmgen_worker -C "vmgen-worker"
#        chmod 600 ~/.ssh/vmgen_worker
#
#   2. Copy the public key to the Proxmox host's vmgen user:
#        ssh-copy-id -i ~/.ssh/vmgen_worker.pub vmgen@172.22.21.95
#      (or manually append to /home/vmgen/.ssh/authorized_keys on Proxmox)
#
#   3. Add the Proxmox host to known_hosts (avoids interactive prompt):
#        ssh-keyscan -H 172.22.21.95 >> ~/.ssh/known_hosts
#
#   4. Test the connection:
#        ssh -i ~/.ssh/vmgen_worker vmgen@172.22.21.95 "echo ok"
#
# Then set the paths below to wherever you saved the key on this VM:
PROXMOX_SSH_KEY_PATH=/home/vmgen/.ssh/vmgen_worker
PROXMOX_KNOWN_HOSTS_PATH=/home/vmgen/.ssh/known_hosts


# --- Worker tuning ---
WORKER_ID=worker-01
WORKER_POLL_INTERVAL_SECONDS=30
WORKER_MAX_CONCURRENT_BUILDS=3


# --- Frontend ---
# Port exposed on the host VM. Access the app at http://<VM_IP>:$FRONTEND_PORT
FRONTEND_PORT=80


# --- Logging ---
LOG_LEVEL=INFO


# =============================================================================
# First-admin bootstrap (one-time, after first deploy)
# =============================================================================
# Roles are USER / ADMIN. New registrations default to USER, and the admin
# promotion endpoint itself requires ADMIN — so the FIRST admin must be set
# directly in the database. After bringing the stack up and registering an
# account in the UI, promote it by email:
#
#   docker compose exec postgres psql -U $DB_USER -d $DB_NAME \
#     -c "UPDATE users SET role='ADMIN' WHERE email='you@example.com';"
#
# Then LOG OUT and LOG BACK IN — the role is embedded in the JWT at login, so
# a fresh token is required before the Admin panel appears. From then on you
# can promote other users from the UI.
# =============================================================================
